#!/usr/bin/env python3
"""Collect non-destructive Daily Retro Driver M1.1 host evidence."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys

from retro_qualification import collect, dumps


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, help="write JSON evidence to this file")
    parser.add_argument("--model-file", type=Path, default=Path("/proc/device-tree/model"), help=argparse.SUPPRESS)
    parser.add_argument("--os-release", type=Path, default=Path("/etc/os-release"), help=argparse.SUPPRESS)
    args = parser.parse_args(argv)

    report = collect(model_file=args.model_file, os_release_file=args.os_release)
    rendered = dumps(report)
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(rendered, encoding="utf-8")
        print(f"Wrote M1.1 evidence: {args.output}")
    else:
        print(rendered, end="")
    return 0 if report["result"] == "PASS" else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("Interrupted", file=sys.stderr)
        raise SystemExit(130)
