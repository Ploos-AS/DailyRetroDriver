#!/usr/bin/env python3
"""Deprecated compatibility alias for scripts/drd-qualify-host."""

from pathlib import Path
import os
import sys


def main() -> None:
    target = Path(__file__).with_name("drd-qualify-host")
    print("WARNING: retro-qualify-host is deprecated; use drd-qualify-host", file=sys.stderr)
    os.execv(sys.executable, [sys.executable, str(target), *sys.argv[1:]])


if __name__ == "__main__":
    main()
